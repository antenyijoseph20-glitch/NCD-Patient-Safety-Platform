# Environment: development / staging / production
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-change-in-production-2026
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Option A: Quick Local Dev with SQLite (Recommended for initial run) ---
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# --- Option B: Production Database with PostgreSQL ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=ncd_platform
# DATABASE_USER=ncd_platform
# DATABASE_PASSWORD=change-me
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Celery & Caching Broker
REDIS_URL=redis://localhost:6379/0

# Optional Telco Gateways (falls back to deterministic simulation if unset)
TERMII_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
